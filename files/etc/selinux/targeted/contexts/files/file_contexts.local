# Equivalent to: semanage fcontext -a -t container_file_t "/data(/.*)?"
#
# Shipped as a file rather than generated by semanage at build time. semanage writes to
# the policy store under /var/lib/selinux, which a bootc image does not ship and which
# customize.sh's own "rm -rf /var/lib/*" would discard -- only this /etc copy survives
# into the image, and it is what restorecon reads at runtime.
#
# /data holds host-provisioned PVCs on a non-standard path; without this label, containers
# cannot read their volumes under enforcing SELinux.
/data(/.*)?    system_u:object_r:container_file_t:s0
