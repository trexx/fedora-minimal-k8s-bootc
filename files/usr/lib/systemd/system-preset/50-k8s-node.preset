# Units this host needs, applied by "systemctl preset-all" in customize.sh. Sorts ahead of
# Fedora's 90-default.preset and the catch-all 99-default-disable.preset, so these win.

# Kubernetes
enable crio.service
enable k0scontroller.service
enable etcd-defrag.timer
enable selinux-booleans.service

# Networking, name resolution and time
enable systemd-networkd.service
enable systemd-resolved.service
enable systemd-timesyncd.service
enable dropbear.service

# Hardware and maintenance
enable thermald.service
enable nvme-health.timer
enable fstrim.timer

# Fedora enables oomd by default. This host has no swap, oomd's only other default policy
# covers user slices, and kubelet does its own eviction -- so it would only be a second,
# uncoordinated OOM killer.
disable systemd-oomd.service
disable systemd-oomd.socket
