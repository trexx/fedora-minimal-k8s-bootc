[Unit]
Description=k0s - Zero Friction Kubernetes
Documentation=https://docs.k0sproject.io
After=network-online.target crio.service
Wants=network-online.target crio.service

[Service]
# kube-proxy and the network provider are turned off in /etc/k0s/k0s.yaml. No worker
# profile is needed for the cgroup driver: since Kubernetes 1.34 kubelet asks CRI-O for it.
ExecStart=/usr/bin/k0s controller --single=true --disable-components=control-api,coredns,endpoint-reconciler,helm,konnectivity-server,metrics-server,node-role --cri-socket=remote:unix:///run/crio/crio.sock
RestartSec=120
Delegate=yes
KillMode=process
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
LimitNOFILE=999999
Restart=always

[Install]
WantedBy=multi-user.target
